# ============================================================
# E-Commerce API — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================================

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecom?retryWrites=true&w=majority

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-secret
JWT_EXPIRES_IN=7d

# --- Node Environment ---
NODE_ENV=development

# --- Admin Seeding (local use only — NEVER add to Vercel) ---
# Used only when running: pnpm run seed:admin
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=choose-a-strong-password
